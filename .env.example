# URL publique du site (canonical, sitemap, OpenGraph)
NEXT_PUBLIC_SITE_URL=https://www.harmony-solutions.fr

# Réception du questionnaire /projet — renseigner UNE des deux options.
# 1) Envoi d'e-mail via Resend (https://resend.com)
RESEND_API_KEY=
PROJECT_FORM_TO=contact@harmony-solutions.fr
PROJECT_FORM_FROM=Harmony Solutions <projet@harmony-solutions.fr>
# 2) Ou un webhook (Make, Zapier, n8n…) qui reçoit le JSON du formulaire
PROJECT_FORM_WEBHOOK_URL=
